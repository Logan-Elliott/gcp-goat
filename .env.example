# Google Cloud OAuth web client
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://operator.example.com/oauth/callback

# Generate both values with: gmail-ops keygen
GMAIL_OAUTH_ENCRYPTION_KEY=replace-me
FLASK_SECRET_KEY=replace-me

# Runtime
GMAIL_OAUTH_DB_PATH=./data/oauth_tokens.db
GMAIL_OAUTH_SCOPE_PROFILE=operator
GMAIL_OAUTH_TRUST_PROXY=false
GMAIL_OAUTH_CAMPAIGN_NAME="Authorized Gmail Assessment"
PORT=8000
